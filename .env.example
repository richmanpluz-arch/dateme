# Copy this file to .env.local and fill in values from Supabase > Project Settings > API.
# Use the project URL and publishable key (sb_publishable_...). Never put a service_role/secret key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY